# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
DATABASE_URL=mysql://db:db@db:3306/db?serverVersion=mariadb-11.8.0&charset=utf8mb4
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test_private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test_public.pem
JWT_PASSPHRASE=test_passphrase
MERCURE_JWT_SECRET=test_mercure_secret_key_minimum_32_chars_!
MERCURE_SUBSCRIBER_JWT_KEY=test_subscriber_jwt_key_minimum_32_chars!
MERCURE_URL=https://mercure.example.com/.well-known/mercure
MERCURE_PUBLIC_URL=https://mercure.example.com/.well-known/mercure
LIVEKIT_API_KEY=test_key
LIVEKIT_API_SECRET=test_livekit_api_secret_minimum_32_chars!
LIVEKIT_PUBLIC_URL=https://livekit.example.com
LIVEKIT_INTERNAL_URL=https://livekit.example.com
# Voice on by default so the existing voice suite runs; a focused test overrides this.
VOICE_ENABLED=true
SERVER_API_URL=http://localhost
MAILER_DSN=null://null
APP_SHARE_DIR=var/share
APP_MEDIA_SIGNING_KEY=test_media_signing_key_minimum_32_chars!
APP_COMMUNITY_EMOJI_MAX_WIDTH=48
APP_COMMUNITY_EMOJI_MAX_HEIGHT=48

REDIS_DSN=tcp://redis:6379
