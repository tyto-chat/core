<h1>{% trans from 'emails' %}password_reset.title{% endtrans %}</h1>

<p>{% trans from 'emails' %}password_reset.intro{% endtrans %}</p>

<p><code>{{ resetPasswordRequest.plainToken }}</code></p>

<p>{% trans with {'%expiryInMinutes%': expiryInMinutes} from 'emails' %}password_reset.code_validity{% endtrans %}</p>

{% if clientBaseUrl|default('') and client|default('web') == 'web' %}
    <p><a href="{{ clientBaseUrl }}/reset-password?step=confirm">{% trans from 'emails' %}password_reset.open_app{% endtrans %}</a></p>
{% endif %}
