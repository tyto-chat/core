# ── tyto.chat core — production env. Copy to `.env`, fill the values, never commit `.env`. ──

# Image version to run. Pin an exact release tag for reproducible deploys, or
# use a minor channel like "1.0" (stable releases only) to receive patch
# releases on every pull. Do NOT use "latest" in prod — it jumps majors.
TYTO_VERSION=1.0.0-beta.3

# Public domain of this core API. Enables auto-HTTPS unless BEHIND_PROXY=true.
SERVER_DOMAIN=chat.example.com

# Behind an existing reverse proxy set true: serves plain HTTP (no certificates
# issued), TLS terminates at your proxy, TRUSTED_PROXIES defaults to
# private_ranges. Combine with HTTP_PORT below.
BEHIND_PROXY=false

# Single-stack bundle only (compose.bundle.yaml): public domain of the bundled
# web client, served by this stack's Caddy. Leave empty when the client runs
# as its own stack.
APP_DOMAIN=

# Single-stack bundle only: web client image version, when it differs from
# TYTO_VERSION. Empty = follow TYTO_VERSION.
CLIENT_VERSION=

# Optional raw Caddy global options — e.g. "email you@example.com" to attach
# an ACME contact to the Let's Encrypt account (cert expiry notices). Certs
# are issued fine without it.
CADDY_GLOBAL_OPTIONS=

# Host ports the stack binds. Change when 80/443 are taken on the host — e.g.
# behind a reverse proxy set HTTP_PORT=8080 and point the proxy there.
HTTP_PORT=80
HTTPS_PORT=443

# Origins of the web (browser) clients allowed to call this API: a space- or
# comma-separated list of exact origins (e.g. "https://app.example.com"), or a
# ^-anchored regex for advanced setups. Leave empty to allow no cross-origin
# browser clients — native desktop/mobile clients are unaffected (no CORS).
CORS_ALLOW_ORIGIN=https://app.example.com

# CORS for the embedded Mercure hub (SSE, real-time). Defaults to * —
# subscriptions are authorized by JWT, not origin. Set a space-separated
# origin list to restrict.
MERCURE_CORS_ORIGINS=

# API URLs — derived from SERVER_DOMAIN (https://<SERVER_DOMAIN>) when left
# empty. Set explicitly only when the public URLs differ from the hostname.
DEFAULT_URI=
SERVER_API_URL=

# Interactive API reference (Swagger UI) at /api. Set false to disable the
# docs UI on this server; the API itself is unaffected.
API_DOCS_ENABLED=true

# Fallback locale for server-rendered content (welcome messages, push
# notifications, emails) when a community/user locale has no catalog.
APP_FALLBACK_LOCALE=en

# Mail is configured in the admin panel (stored in the DB, password
# encrypted). MAILER_DSN is only an optional env-level fallback transport;
# when empty, mail is discarded until SMTP is set up in the panel.
# Branding (server name, description, digest hour, default bot) also live in
# the admin panel's settings registry.
MAILER_DSN=

# Encryption key for the DB-stored SMTP password. Set a stable 32-byte hex value
# (openssl rand -hex 32) so the stored secret survives an APP_SECRET rotation.
# Derived from APP_SECRET when left unset.
APP_SMTP_KEY=

# Database passwords, Meilisearch master key and the LiveKit API key/secret
# are AUTO-GENERATED into the shared secrets volume on first boot — leave
# these empty unless you need specific values (managed DB, external LiveKit).
# A non-empty value here always overrides the generated one.
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
MEILI_MASTER_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Full DB DSN override (only for an external/managed database; when empty it
# is derived as mysql://tyto:<generated>@database:3306/tyto).
DATABASE_URL=

# Branding / behavior live in the settings registry (admin panel), not env.
VAPID_SUBJECT=mailto:admin@example.com

# LiveKit voice endpoints. The signal WebSocket is proxied by the app on
# /rtc, so LIVEKIT_PUBLIC_URL derives from SERVER_DOMAIN when left empty —
# set it only for an external LiveKit with its own TLS. Voice media needs
# 7881/tcp + 50000-50100/udp open on this host (see VOICE_ENABLED below).
LIVEKIT_PUBLIC_URL=
LIVEKIT_INTERNAL_URL=http://livekit:7880

# Set false for a text-only server — e.g. a 443-only host where LiveKit's
# UDP/TURN can't be exposed. Hides all voice UI and refuses voice operations
# server-side. Default true.
VOICE_ENABLED=true

# Redis cache pool (Symfony) — redis:// scheme. Defaults to the bundled redis sidecar.
CACHE_DSN=redis://redis:6379

# Trusted reverse proxies. Empty when FrankenPHP terminates TLS itself. With
# BEHIND_PROXY=true this defaults to private_ranges; set your proxy's CIDR
# (e.g. 10.0.0.0/8) to narrow it.
TRUSTED_PROXIES=
# Host-header allowlist regex (recommended in prod), e.g. ^chat\.example\.com$
TRUSTED_HOSTS=^${SERVER_DOMAIN}$

# Secrets below are AUTO-GENERATED into the `secrets` volume on first boot
# (they're only needed by the app process itself, incl. embedded Mercure).
# Override here only if you must pin them across hosts:
# APP_SECRET= JWT_PASSPHRASE= MERCURE_JWT_SECRET= MERCURE_SUBSCRIBER_JWT_KEY=
# APP_MEDIA_SIGNING_KEY= VAPID_PUBLIC_KEY= VAPID_PRIVATE_KEY=
