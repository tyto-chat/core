# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://db:db@127.0.0.1:3306/db?serverVersion=mariadb-11.8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

# Optional 32-byte hex key (openssl rand -hex 32) for encrypting the DB-stored
# SMTP password. Derived from APP_SECRET when unset.
APP_SMTP_KEY=

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=https://example.com/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=https://example.com/.well-known/mercure
# The secret used to sign the JWTs. HS256 rejects anything under 32 bytes.
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Secret — set the real value in .env.local (dev) or the environment (prod)
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###
# Signs subscriber tokens; set it in .env.local (dev) or the environment (prod).
# HS256 rejects anything under 32 bytes — openssl rand -hex 32
MERCURE_SUBSCRIBER_JWT_KEY=

###> livekit ###
LIVEKIT_API_KEY=devkey
# >=32 chars: LiveKit signs JWTs with HS256, which requires a key of at least
# 32 bytes. A short dev value here would crash voice with "provided key is too
# short" if it ever surfaced as a fallback (prod overrides via .env.local).
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-dev
# Real values are written to .env.local by `ddev init` (dev) or come from the
# environment (prod).
LIVEKIT_PUBLIC_URL=https://livekit.core.ddev.site
LIVEKIT_INTERNAL_URL=http://ddev-core-livekit:7880
###< livekit ###

# Set to false to run a text-only server (e.g. when only port 443 is reachable
# and LiveKit's UDP/TURN cannot be exposed). Hides all voice UI on the client
# and makes the server refuse voice token issuance + audio-channel creation.
VOICE_ENABLED=true
SERVER_API_URL=http://tyto-chat.ddev.site

###> community emoji upload ###
# Liip Imagine resizes every upload to fit inside this box (mode: inset,
# aspect ratio preserved), so the largest dimension ends up at 48px.
APP_COMMUNITY_EMOJI_MAX_WIDTH=48
APP_COMMUNITY_EMOJI_MAX_HEIGHT=48
###< community emoji upload ###

###> media signed urls ###
# Required: 32+ char random string. Set in .env.local (dev) or via Vault/env (prod).
# Empty triggers a hard fail at boot — see App\Service\SignedUrlService.
APP_MEDIA_SIGNING_KEY=
###< media signed urls ###

# E2E test reset endpoint token — set a real value in .env.local
E2E_TEST_TOKEN=

###> i18n ###
# Fallback for server-rendered content (welcome messages, push, emails) when
# the requested locale has no translation catalog.
APP_FALLBACK_LOCALE=en
###< i18n ###

###> api docs ###
# Interactive API reference (Swagger UI) at /api and /api/v1/docs.
# Set false on deployed servers to disable the docs UI entirely.
API_DOCS_ENABLED=true
###< api docs ###

###> meilisearch ###
# Override MEILI_MASTER_KEY in .env.local with a random 32-byte hex secret
MEILI_MASTER_KEY=
MEILI_URL=http://meilisearch:7700
###< meilisearch ###

###> redis (presence) ###
REDIS_DSN=tcp://redis:6379?timeout=2&read_write_timeout=2
# Symfony cache pool uses the redis:// scheme (predis presence client uses tcp:// above).
CACHE_DSN=redis://redis:6379
###< redis (presence) ###

###> email digest ###
# (digest hour is now the `digestHour` server setting, tuned in the admin panel)
###< email digest ###

###> web-push (VAPID) ###
# Generate a keypair with Minishlink\WebPush\VAPID::createVapidKeys() and put
# both values in .env.local. The public key is non-secret (shipped to clients
# via /api/server-info); the private key MUST stay in .env.local only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
###< web-push (VAPID) ###

###> GDPR data export ###
# Absolute path where generated user data-export ZIPs are stored. Files live
# here for DataExportRequest::DOWNLOAD_TTL_DAYS (7d) and are deleted by the
# daily scheduler.
APP_EXPORT_DIR=%kernel.project_dir%/var/exports
###< GDPR data export ###

###> http cache purge ###
# Internal base URL of the Souin admin API (empty = purging disabled).
# Production sets this to Caddy's loopback admin API, e.g. http://localhost:2019
# (Souin and the app share one FrankenPHP container, so purges only work same-container.)
CACHE_PURGE_URL=
###< http cache purge ###

###> trusted proxies / hosts ###
# Empty by default (FrankenPHP is the edge). Behind an external proxy set to its
# CIDR, e.g. TRUSTED_PROXIES=10.0.0.0/8. Symfony also accepts the keyword private_ranges.
TRUSTED_PROXIES=
# Empty = allow any Host. In prod set a regex, e.g. TRUSTED_HOSTS=^chat\.example\.com$
TRUSTED_HOSTS=
###< trusted proxies / hosts ###
