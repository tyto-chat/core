{
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "agence104/livekit-server-sdk": "^1.3",
        "api-platform/doctrine-orm": "^4.4.6",
        "api-platform/symfony": "^4.4.6",
        "doctrine/doctrine-bundle": "^3.3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.5",
        "friendsofsymfony/http-cache-bundle": "^3.4.1",
        "gesdinet/jwt-refresh-token-bundle": "^2.2.2",
        "guzzlehttp/promises": "^2.6",
        "league/commonmark": "^2.7",
        "lexik/jwt-authentication-bundle": "^3.2",
        "liip/imagine-bundle": "^2.18.1",
        "meilisearch/meilisearch-php": "^1.17",
        "minishlink/web-push": "^10.1",
        "nelmio/cors-bundle": "^2.6",
        "nelmio/security-bundle": "^3.9",
        "nyholm/psr7": "^1.8",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.3.6",
        "predis/predis": "^3.7",
        "spomky-labs/otphp": "^11.5",
        "stof/doctrine-extensions-bundle": "^1.15",
        "symfony/cache": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "7.4.*",
        "symfony/html-sanitizer": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/mercure-bundle": "^0.4.3",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^3.0|^4.1.0",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/web-link": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/extra-bundle": "^2.12|^3.29",
        "twig/twig": "^2.12|^3.30",
        "vich/uploader-bundle": "^2.10.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.dist.neon",
        "phpstan-baseline": "vendor/bin/phpstan analyse -c phpstan.dist.neon --generate-baseline",
        "fixcs": "vendor/bin/php-cs-fixer fix",
        "checkcs": "vendor/bin/php-cs-fixer check"
    },
    "conflict": {
        "symfony/asset": ">=7.5",
        "symfony/browser-kit": ">=7.5",
        "symfony/cache": ">=7.5",
        "symfony/clock": ">=7.5",
        "symfony/config": ">=7.5",
        "symfony/console": ">=7.5",
        "symfony/css-selector": ">=7.5",
        "symfony/debug-bundle": ">=7.5",
        "symfony/dependency-injection": ">=7.5",
        "symfony/doctrine-bridge": ">=7.5",
        "symfony/doctrine-messenger": ">=7.5",
        "symfony/dom-crawler": ">=7.5",
        "symfony/dotenv": ">=7.5",
        "symfony/error-handler": ">=7.5",
        "symfony/event-dispatcher": ">=7.5",
        "symfony/expression-language": ">=7.5",
        "symfony/filesystem": ">=7.5",
        "symfony/finder": ">=7.5",
        "symfony/framework-bundle": ">=7.5",
        "symfony/html-sanitizer": ">=7.5",
        "symfony/http-client": ">=7.5",
        "symfony/http-foundation": ">=7.5",
        "symfony/http-kernel": ">=7.5",
        "symfony/intl": ">=7.5",
        "symfony/mailer": ">=7.5",
        "symfony/messenger": ">=7.5",
        "symfony/mime": ">=7.5",
        "symfony/monolog-bridge": ">=7.5",
        "symfony/options-resolver": ">=7.5",
        "symfony/password-hasher": ">=7.5",
        "symfony/process": ">=7.5",
        "symfony/property-access": ">=7.5",
        "symfony/property-info": ">=7.5",
        "symfony/rate-limiter": ">=7.5",
        "symfony/routing": ">=7.5",
        "symfony/runtime": ">=7.5",
        "symfony/scheduler": ">=7.5",
        "symfony/security-bundle": ">=7.5",
        "symfony/security-core": ">=7.5",
        "symfony/security-csrf": ">=7.5",
        "symfony/security-http": ">=7.5",
        "symfony/serializer": ">=7.5",
        "symfony/stopwatch": ">=7.5",
        "symfony/string": ">=7.5",
        "symfony/symfony": "*",
        "symfony/translation": ">=7.5",
        "symfony/twig-bridge": ">=7.5",
        "symfony/twig-bundle": ">=7.5",
        "symfony/type-info": ">=7.5",
        "symfony/uid": ">=7.5",
        "symfony/validator": ">=7.5",
        "symfony/var-dumper": ">=7.5",
        "symfony/var-exporter": ">=7.5",
        "symfony/web-link": ">=7.5",
        "symfony/web-profiler-bundle": ">=7.5",
        "symfony/yaml": ">=7.5"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3.2",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^13.4.5",
        "rector/rector": "^2.8.1",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*",
        "zenstruck/foundry": "^2.14.1"
    }
}
